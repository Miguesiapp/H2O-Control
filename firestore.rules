rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================================
    // --- FUNCIONES DE SEGURIDAD Y ROLES ---
    // ========================================================================

    // Lista Blanca Global: Verifica si el usuario está logueado y es empleado oficial
    function isAuthorized() {
      return request.auth != null && (
        request.auth.token.email == 'miguesilva.1985@outlook.es' ||
        request.auth.token.email == 'miguesilva.1985@gmail.com' ||
        request.auth.token.email == 'produccion@h2ocontrol.com.ar' ||
        request.auth.token.email == 'francovanucci1995@gmail.com' ||
        request.auth.token.email == 'francovanuccilemmi@gmail.com' ||
        request.auth.token.email == 'eugeniofangareggi@gmail.com' ||
        request.auth.token.email == 'ivancamuzzimdp@gmail.com' ||
        request.auth.token.email == 'g.haritchet@gmail.com' ||
        request.auth.token.email == 'bduville@h2ocontrol.com.ar' ||
        request.auth.token.email == 'jmalvasio@h2ocontrol.com.ar' ||
        request.auth.token.email == 'nachoracing.02@gmail.com' ||
        request.auth.token.email == 'acostaeduardoa@outlook.com' ||
        request.auth.token.email == 'juanpae.mdp@gmail.com' ||
        request.auth.token.email == 'eig.seguridadysalud@gmail.com' ||
        request.auth.token.email == 'tester@h2ocontrol.com'
      );
    }

    // ========================================================================
    // --- REGLAS POR COLECCIÓN — Todos los autorizados pueden hacer todo ---
    // ========================================================================

    match /StaffLogs/{log} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /StaffProfiles/{profile} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /Orders/{order} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /EIG_Documents/{docId} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /Users/{userId} {
      allow read, create, update: if isAuthorized();
      allow delete: if false;
    }

    match /Inventory/{item} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /Formulas_Maestras/{formula} {
      allow read, write: if isAuthorized();
    }

    match /Produccion_Lotes/{lote} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /AuditLog/{log} {
      allow read, create: if isAuthorized();
      allow update, delete: if false;
    }

    match /cola_impresion/{ticket} {
      allow read, create, update, delete: if isAuthorized();
    }

    match /Formulas/{formula} {
      allow read, write: if isAuthorized();
    }

    match /Custom_Materials/{material} {
      allow read, write: if isAuthorized();
    }

    match /logs/{log} {
      allow read, create: if isAuthorized();
      allow update, delete: if false;
    }

    match /PurchaseRequests/{docId} {
      allow read, write: if isAuthorized();
    }

    match /Eventualities/{eventuality} {
      allow read, write: if isAuthorized();
    }
  }
}
